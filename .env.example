GITLAB_URL=https://gitlab.example.com
GITLAB_PRIVATE_TOKEN=<token>
# На dev можно установить false, чтобы получать только первую страницу проектов.
GITLAB_PROJECTS_ITERATOR=true

RADAR_HOST=0.0.0.0
RADAR_PORT=8000
RADAR_RELOAD=false

RADAR_AUTH_PREFERRED_USERNAMES=user.one

# RADAR_AUTH_ISSUER=https://gitlab.com
# RADAR_AUTH_INTERNAL_URL=https://gitlab.com

# Keycloak: если RADAR_AUTH_ISSUER не задан, issuer формируется из PUBLIC_URL и REALM.
RADAR_AUTH_PUBLIC_URL=https://keycloak.example.com
RADAR_AUTH_INTERNAL_URL=https://keycloak.example.com
RADAR_AUTH_REALM=example
RADAR_AUTH_CLIENT_ID=<oidc-client-id>
RADAR_AUTH_CLIENT_SECRET=<oidc-client-secret>
RADAR_AUTH_SESSION_SECRET=<random-secret-at-least-32-characters>
APP_PUBLIC_URL=http://127.0.0.1:8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RADAR_DB_USER=radar
RADAR_DB_PASSWORD=radar
RADAR_DB_SCHEMA=radar
