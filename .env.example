GITLAB_URL=https://gitlab.example.com
GITLAB_PRIVATE_TOKEN=<token>

RADAR_HOST=0.0.0.0
RADAR_PORT=8000
RADAR_RELOAD=false

RADAR_AUTH_REQUIRED=false
RADAR_AUTH_DEVELOPMENT_USERNAME=local-admin
RADAR_AUTH_PREFERRED_USERNAMES=
RADAR_AUTH_PUBLIC_URL=https://keycloak.example.com
RADAR_AUTH_INTERNAL_URL=https://keycloak.example.com
RADAR_AUTH_REALM=example
RADAR_AUTH_CLIENT_ID=gitlab-radar-web
APP_PUBLIC_URL=http://127.0.0.1:8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RADAR_DB_USER=radar
RADAR_DB_PASSWORD=radar
RADAR_DB_SCHEMA=radar
