GITLAB_URL=https://gitlab.example.com
GITLAB_PRIVATE_TOKEN=<token>

RADAR_HOST=0.0.0.0
RADAR_PORT=8000
RADAR_RELOAD=false

RADAR_AUTH_PUBLIC_URL=http://127.0.0.1:8080
RADAR_AUTH_INTERNAL_URL=http://keycloak:8080
RADAR_AUTH_REALM=gitlab-radar
RADAR_AUTH_CLIENT_ID=gitlab-radar-web
APP_PUBLIC_URL=http://127.0.0.1:8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RADAR_DB_USER=radar
RADAR_DB_PASSWORD=radar
RADAR_DB_SCHEMA=radar

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak
KC_HTTP_ENABLED=true

RADAR_DEFAULT_USER=radar
RADAR_DEFAULT_USER_PASSWORD=radar
RADAR_DEFAULT_USER_EMAIL=radar@localhost
