{
  "realm": "${RADAR_AUTH_REALM}",
  "enabled": true,
  "displayName": "GitLab Radar",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "${RADAR_AUTH_CLIENT_ID}",
      "name": "GitLab Radar Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${APP_PUBLIC_URL}/*"],
      "webOrigins": ["${APP_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "gitlab-radar audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${RADAR_AUTH_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${RADAR_DEFAULT_USER}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Radar",
      "lastName": "Administrator",
      "email": "${RADAR_DEFAULT_USER_EMAIL}",
      "credentials": [
        {
          "type": "password",
          "value": "${RADAR_DEFAULT_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
